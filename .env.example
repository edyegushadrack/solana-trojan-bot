# Helius / QuickNode / Triton RPC endpoint (public RPCs are too slow for sniping)
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Base58-encoded secret key of your hot wallet (Phantom export format)
PRIVATE_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram numeric user id — the bot will refuse commands from anyone else
TELEGRAM_OWNER_ID=

# Optional: default slippage in basis points if a command omits it (100 = 1%)
DEFAULT_SLIPPAGE_BPS=100

# --- Paper trading (safety default: ON) ---
# Must be set to "false" here AND toggled off with /paper off in the bot —
# see README. Leave this as-is (or unset) until you're ready for real trades.
PAPER_TRADING=true
# Starting simulated SOL balance for paper trading
PAPER_STARTING_SOL=10

# --- Snipe engine (Phase 2) ---
# Minimum SOL liquidity a pump.fun launch needs to pass the basic pre-filter
SNIPE_MIN_LIQUIDITY_SOL=5
# SOL spent per snipe buy — keep this small until the risk layer (Phase 4) exists
SNIPE_BUY_SOL=0.05
# Jito tip in lamports (100000 = 0.0001 SOL) — higher tip = better chance of landing
SNIPE_TIP_LAMPORTS=100000
# Wide slippage tolerance since new-pool prices move fast in the first seconds
SNIPE_SLIPPAGE_BPS=500
