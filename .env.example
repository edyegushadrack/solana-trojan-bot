# Helius / QuickNode / Triton RPC endpoint (public RPCs are too slow for sniping)
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Base58-encoded secret key of your hot wallet (Phantom export format)
PRIVATE_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram numeric user id — the bot will refuse commands from anyone else
TELEGRAM_OWNER_ID=

# Optional: default slippage in basis points if a command omits it (100 = 1%)
DEFAULT_SLIPPAGE_BPS=100

# --- Paper trading (safety default: ON) ---
# Must be set to "false" here AND toggled off with /paper off in the bot —
# see README. Leave this as-is (or unset) until you're ready for real trades.
PAPER_TRADING=true
# Starting simulated SOL balance for paper trading
PAPER_STARTING_SOL=10

# --- Snipe engine (Phase 2) ---
# Minimum SOL liquidity a pump.fun launch needs to pass the basic pre-filter
SNIPE_MIN_LIQUIDITY_SOL=5
# SOL spent per snipe buy — keep this small until the risk layer (Phase 4) exists
SNIPE_BUY_SOL=0.05
# Jito tip in lamports (100000 = 0.0001 SOL) — higher tip = better chance of landing
SNIPE_TIP_LAMPORTS=100000
# Wide slippage tolerance since new-pool prices move fast in the first seconds
SNIPE_SLIPPAGE_BPS=500
# Max candidates processed at once. Raise only alongside a higher RPC tier —
# each one fires several RPC calls, and this is what actually controls your
# request rate, not the liquidity filter above (see filters.js for why).
SNIPE_MAX_CONCURRENT=2

# --- Risk / safety layer (Phase 4) ---
# Hard ceiling on SOL spent in any single trade, regardless of what a
# command or the snipe engine asks for. Raise deliberately, never by accident.
RISK_MAX_SPEND_SOL=0.1
# Reject any trade whose requested slippage exceeds this
RISK_MAX_SLIPPAGE_BPS=1000
# Reject any trade whose Jupiter quote shows price impact above this (%)
RISK_MAX_PRICE_IMPACT_PCT=15

# --- Deployer history check (optional) ---
# Reads the meme-scanner's Supabase project to flag wallets with an
# unusually high count of prior pump.fun launches (mass-deployer pattern).
# Leave unset to skip this check entirely — everything else still works.
# This is the project's anon/publishable key with a read-only policy on
# the launches table specifically — safe to commit, it can't write or read
# anything else.
SUPABASE_URL=https://yydynsrnrcwjskouibvf.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl5ZHluc3JucmN3anNrb3VpYnZmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkxNjI5NzcsImV4cCI6MjEwNDczODk3N30.UHmJYAZT81hyRwT3MsJKfbJsIRNCMhAsnqwsHsRQab4
# Prior-launch count above which a deployer is flagged (see README for why
# this threshold, not e.g. average score)
RISK_MAX_DEPLOYER_PRIOR_LAUNCHES=15
